{
  "uid": "kafka-bridge",
  "title": "Kafka Bridge",
  "tags": ["bridge", "kafka", "ecommerce"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Events Received / sec (all workers)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(bridge_events_received_total[1m]))",
          "legendFormat": "total"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(bridge_events_received_total[1m])",
          "legendFormat": "{{worker}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "Events Sent to Kafka / sec (all workers)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(bridge_events_sent_total[1m]))",
          "legendFormat": "total"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(bridge_events_sent_total[1m])",
          "legendFormat": "{{worker}}"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "unit": "reqps" } }
    },
    {
      "id": 3,
      "title": "Failed & Dead Letter / sec",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(bridge_events_failed_total[1m]))",
          "legendFormat": "failed/s"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(bridge_events_dead_letter_total[1m]))",
          "legendFormat": "dead-letter/s"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "reqps" } }
    },
    {
      "id": 4,
      "title": "Total Events Received",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(bridge_events_received_total)",
        "legendFormat": "total received"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "Total Events Sent",
      "type": "stat",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(bridge_events_sent_total)",
        "legendFormat": "total sent"
      }],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "unit": "short" } }
    },
    {
      "id": 6,
      "title": "Total Failed",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(bridge_events_failed_total)",
        "legendFormat": "failed"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 10 }
        ]}}
      }
    },
    {
      "id": 7,
      "title": "Dead Letter Total",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(bridge_events_dead_letter_total)",
        "legendFormat": "dead letter"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]}}
      }
    },
    {
      "id": 8,
      "title": "Kafka Errors Total",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(bridge_kafka_errors_total)",
        "legendFormat": "kafka errors"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]}}
      }
    },
    {
      "id": 9,
      "title": "Worker Uptime",
      "type": "stat",
      "gridPos": { "x": 20, "y": 8, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "bridge_uptime_seconds",
        "legendFormat": "{{worker}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "fixedColor": "blue", "mode": "fixed" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "title": "Events per Worker (breakdown)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(bridge_events_sent_total[1m])",
          "legendFormat": "sent — {{worker}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(bridge_events_received_total[1m])",
          "legendFormat": "received — {{worker}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11,
      "title": "Geo Lookups vs Cache Hits",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(bridge_geo_lookups_total[1m]))",
          "legendFormat": "lookups/s"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(bridge_geo_cache_hits_total[1m]))",
          "legendFormat": "cache hits/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ],
  "schemaVersion": 36
}
